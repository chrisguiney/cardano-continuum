# Local git worktrees for feature branches.
.worktrees/

# Downloaded Java and TLA+ tools. Recreate with `make models-install`.
.tools/

# TLC's working directory, left in a model directory by a direct bin/tlc run
# (run-model.sh gives each run a private -metadir instead).
/models/specs/*/states/

# Build outputs at the module root and in bin/ (models/bin holds committed wrappers).
/bin/
/dist/

# Go test and coverage artifacts.
*.test
*.out
coverage.txt

# Web UI dependencies; web/dist is committed on purpose.
web/node_modules/

# Python bytecode and caches from lab/.
__pycache__/
.pytest_cache/

# Regenerated scenario material; scenarios/ holds only the curated set.
/scenarios/generated/
/scenarios/seeds/
/scenarios/vectors/

# Jupyter notebook checkpoints.
.ipynb_checkpoints/
