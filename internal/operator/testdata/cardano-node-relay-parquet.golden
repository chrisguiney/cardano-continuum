config:
  data:
    topology.json: |
      {
        "localRoots": [
          {
            "accessPoints": [
              {
                "address": "pool-b.ns.svc.cluster.local",
                "port": 3001
              }
            ],
            "advertise": false,
            "trustable": true,
            "valency": 1
          }
        ],
        "publicRoots": [],
        "useLedgerAfterSlot": -1
      }
  metadata:
    annotations:
      continuum.blinklabs.io/pool-name: a
    labels:
      continuum.blinklabs.io/impl: cardano-node
      continuum.blinklabs.io/owner: uid-0000
      continuum.blinklabs.io/pool: fa6c9f96d373eca1
      continuum.blinklabs.io/role: relay
      continuum.blinklabs.io/workload: relay-ca978112ca1bbdca
    name: relay-ca978112ca1bbdca-config
    namespace: ns
    ownerReferences:
    - apiVersion: continuum.blinklabs.io/v1alpha1
      blockOwnerDeletion: true
      controller: true
      kind: ContinuumPool
      name: a
      uid: uid-0000
service:
  apiVersion: v1
  kind: Service
  metadata:
    annotations:
      continuum.blinklabs.io/pool-name: a
    labels:
      continuum.blinklabs.io/impl: cardano-node
      continuum.blinklabs.io/owner: uid-0000
      continuum.blinklabs.io/pool: fa6c9f96d373eca1
      continuum.blinklabs.io/role: relay
      continuum.blinklabs.io/workload: relay-ca978112ca1bbdca
    name: relay-ca978112ca1bbdca
    namespace: ns
    ownerReferences:
    - apiVersion: continuum.blinklabs.io/v1alpha1
      blockOwnerDeletion: true
      controller: true
      kind: ContinuumPool
      name: a
      uid: uid-0000
  spec:
    clusterIP: None
    ports:
    - name: n2n
      port: 3001
      targetPort: 3001
    - name: ntc
      port: 3002
      targetPort: 3002
    publishNotReadyAddresses: true
    selector:
      continuum.blinklabs.io/workload: relay-ca978112ca1bbdca
  status:
    loadBalancer: {}
statefulSet:
  apiVersion: apps/v1
  kind: StatefulSet
  metadata:
    annotations:
      continuum.blinklabs.io/pool-name: a
    labels:
      continuum.blinklabs.io/impl: cardano-node
      continuum.blinklabs.io/owner: uid-0000
      continuum.blinklabs.io/pool: fa6c9f96d373eca1
      continuum.blinklabs.io/role: relay
      continuum.blinklabs.io/workload: relay-ca978112ca1bbdca
    name: relay-ca978112ca1bbdca
    namespace: ns
    ownerReferences:
    - apiVersion: continuum.blinklabs.io/v1alpha1
      blockOwnerDeletion: true
      controller: true
      kind: ContinuumPool
      name: a
      uid: uid-0000
  spec:
    podManagementPolicy: OrderedReady
    replicas: 1
    selector:
      matchLabels:
        continuum.blinklabs.io/workload: relay-ca978112ca1bbdca
    serviceName: relay-ca978112ca1bbdca
    template:
      metadata:
        annotations:
          continuum.blinklabs.io/pool-name: a
        labels:
          continuum.blinklabs.io/impl: cardano-node
          continuum.blinklabs.io/owner: uid-0000
          continuum.blinklabs.io/pool: fa6c9f96d373eca1
          continuum.blinklabs.io/role: relay
          continuum.blinklabs.io/workload: relay-ca978112ca1bbdca
      spec:
        automountServiceAccountToken: false
        containers:
        - args:
          - run
          - --config
          - /genesis/config.json
          - --topology
          - /config/topology.json
          - --database-path
          - /data/db
          - --socket-path
          - /data/node.socket
          - --host-addr
          - 0.0.0.0
          - --port
          - "3001"
          command:
          - cardano-node
          image: r@sha256:aaaa
          imagePullPolicy: IfNotPresent
          name: node
          ports:
          - containerPort: 3001
            name: n2n
          resources:
            requests:
              cpu: 250m
              memory: 1Gi
          volumeMounts:
          - mountPath: /genesis
            name: genesis
            readOnly: true
          - mountPath: /config
            name: config
            readOnly: true
          - mountPath: /data
            name: data
        - command:
          - socat
          - TCP-LISTEN:3002,fork,reuseaddr
          - UNIX-CONNECT:/data/node.socket
          image: r@sha256:aaaa
          imagePullPolicy: IfNotPresent
          name: ntc
          ports:
          - containerPort: 3002
            name: ntc
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
          volumeMounts:
          - mountPath: /data
            name: data
        - command:
          - /usr/local/bin/mithril2pq
          - -watch
          - 60s
          - -immutable-dir
          - /data/db/immutable
          - -network-magic
          - "42"
          - -out
          - /parquet/a
          image: mithril2pq:test
          name: mithril2pq
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
          volumeMounts:
          - mountPath: /data
            name: data
            readOnly: true
          - mountPath: /parquet
            name: parquet
        enableServiceLinks: false
        imagePullSecrets:
        - name: pull
        volumes:
        - configMap:
            name: genesis
          name: genesis
        - configMap:
            name: relay-ca978112ca1bbdca-config
          name: config
        - emptyDir: {}
          name: data
        - name: parquet
          persistentVolumeClaim:
            claimName: parquet
    updateStrategy:
      type: RollingUpdate
  status:
    availableReplicas: 0
    replicas: 0
